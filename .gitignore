.env
.env.local
.env.*.local
!.env.example

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node ───────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo

# ── Outils ─────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.log

# ── Artefacts générés ──────────────────────────────────────
/tmp/
*.pdf
!frontend/public/**/*.pdf
