# ── Secrets ────────────────────────────────────────────────
# À garder en tête de fichier : ces lignes protègent des clés réelles.
.env
.env.local
.env.*.local
!.env.example

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node ───────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo

# ── Outils ─────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.log

# ── Artefacts générés ──────────────────────────────────────
/tmp/
*.pdf
!frontend/public/**/*.pdf

# ── Corpus d'évaluation du moteur de candidature ───────────
# Instantanés de pages, reconstructibles :
#   cd backend/job-discovery && python -m tests.harness.freeze
# Plusieurs dizaines de mégaoctets, sans valeur historique. Le manifeste et
# les corrigés publiés par l'ATS, eux, sont versionnés.
backend/job-discovery/tests/corpus/pages/
backend/job-discovery/tests/corpus/runs/
