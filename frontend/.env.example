# URL de l'API (backend/job-discovery). À fournir AU BUILD : Next l'inscrit
# dans le bundle ; sans elle, le site déployé appelle le localhost du visiteur.
NEXT_PUBLIC_API_URL=http://localhost:8000

# La connexion (lien + code par e-mail) est gérée par l'API : rien à
# configurer ici. En développement, l'API indique si elle est désactivée.
