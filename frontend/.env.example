# URL de l'API (backend/job-discovery).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Authentification (Supabase Auth) ───────────────────────
# Project Settings → API. La clé « anon » est publique par construction.
# Laissées vides, l'application tourne sans connexion : réservé au
# développement local, avec AUTH_DISABLED=true côté API.
# Ajouter <FRONTEND_URL>/auth/confirmed aux « Redirect URLs » du projet
# (Authentication → URL Configuration).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
