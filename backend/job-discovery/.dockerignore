# Le Dockerfile fait `COPY . .` : sans ce fichier, les secrets réels partent
# dans l'image, où ils restent lisibles par quiconque peut la télécharger.
# Les variables sont injectées à l'exécution (env_file / variables du service).
.env
.env.*
!.env.example

.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

.git/
.gitignore
*.log
*.pdf
