# ── job-discovery ──────────────────────────────────────────
# Copier vers .env et renseigner les valeurs.
# NE JAMAIS commiter le .env : il contient des secrets réels.

# ── Base de données ────────────────────────────────────────
# En local :
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_discovery
#
# Sur Supabase : Project Settings → Database → Connection string, onglet
# « Session pooler » (port 5432, joignable en IPv4 depuis Railway). Le préfixe
# postgresql:// est converti automatiquement :
#   postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Le « Transaction pooler » (6543) fonctionne aussi, mais Alembic doit alors
# passer par le Session pooler.
#
# Connexions par processus : sur Supabase, viser 3 + 2.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Le mot de passe de la base est distinct des clés d'API ci-dessous ; aucune
# clé Supabase ne permet de migrer un schéma.
#
# Le schéma est géré par Alembic : `alembic upgrade head`.

# ── Supabase ───────────────────────────────────────────────
SUPABASE_URL=
# Clé « service_role » : réservée au backend. Elle contourne la sécurité au
# niveau des lignes, donc elle ne doit JAMAIS être exposée au navigateur.
# Le frontend utilise la clé « anon », via NEXT_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_KEY=

# ── Authentification ───────────────────────────────────────
# Connexion par e-mail (lien + code) envoyés via Resend ; l'API signe les
# sessions avec AUTH_SECRET. Longue chaîne aléatoire, à ne jamais changer en
# production (toutes les sessions tomberaient) :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
SESSION_DAYS=30
# Développement local UNIQUEMENT : lève toutes les gardes d'accès. Sans
# AUTH_SECRET et avec DEBUG=true, les gardes sont aussi levées. Jamais en
# production — n'importe qui pourrait lire n'importe quel profil.
AUTH_DISABLED=false
# E-mails autorisés à déclencher scraping et seeding via l'API.
ADMIN_EMAILS=briand@alice-agent.fr
# Optionnel : jetons Supabase Auth acceptés en plus (secret JWT du projet).
SUPABASE_JWT_SECRET=

# ── Redis (courtier Celery) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# true : crée les tables au démarrage et active les logs verbeux.
# À laisser sur false en production, où Alembic prend le relais.
DEBUG=true

# ── Gemini ─────────────────────────────────────────────────
# Requis : conversation, qualification des annonces, rédaction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── France Travail — API « Offres d'emploi v2 » ────────────
# Source principale des offres. Créer une application sur
# https://francetravail.io PUIS l'abonner à « Offres d'emploi v2 » :
# l'abonnement est une étape distincte, et sans lui l'authentification
# renvoie invalid_client.
IDENTIFIER_FRANCE_TRAVAIL=      # client_id, format PAR_<appli>_<hex>
FRANCE_TRAVAIL_API=             # client_secret, 64 caractères hex

# ── SMTP (repli si RESEND_API_KEY est vide) ────────────────
# Sans Resend ni SMTP, les candidatures sont SIMULÉES : rien ne part, et
# l'interface le dit.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Candidature
SMTP_USE_TLS=true

# ── Candidature par formulaire (pilotage navigateur) ───────
# Alice remplit les formulaires ATS dans un vrai navigateur, guidée par le
# schéma de champs publié par la plateforme. Tant que ceci vaut false, elle
# remplit puis s'arrête AVANT de soumettre : la candidature est enregistrée en
# SIMULATED, jamais en SENT.
#
# Cet interrupteur est distinct de l'autorisation du mandat. Le mandat dit
# « tu peux postuler pour moi » ; celui-ci dit « ce serveur a le droit de
# cliquer sur Soumettre ». Les deux sont nécessaires.
#
# Requiert : pip install -e ".[browser]" && playwright install chromium
BROWSER_SUBMIT_ENABLED=false
BROWSER_HEADLESS=true

# ── La bonne alternance (API Apprentissage) ────────────────
# Offres d'alternance auxquelles Alice transmet elle-même la candidature.
# Clé gratuite : https://api.apprentissage.beta.gouv.fr (compte développeur).
# Clé production : recherche des offres sans habilitation. L'envoi des
# candidatures exige une habilitation, à demander à
# contact-api@labonnealternance.apprentissage.beta.gouv.fr. Une clé sandbox
# permet de tester l'envoi avant, mais ses offres sont fictives : jamais en prod.
LBA_API_KEY=

# ── INSEE SIRENE (optionnel) ───────────────────────────────
# Enrichissement des entreprises. https://api.insee.fr/
SIRENE_API_TOKEN=

# ── Scraping ATS ───────────────────────────────────────────
SCRAPE_INTERVAL_HOURS=24
SCRAPE_REQUEST_TIMEOUT=15
SCRAPE_MAX_CONCURRENT=10

# ── Matching ───────────────────────────────────────────────
# Score minimum pour qu'une offre entre dans la liste du candidat.
MATCH_MIN_SCORE=55
# Score à partir duquel elle passe en haut du panier.
MATCH_SHORTLIST_SCORE=78

# ── CORS ───────────────────────────────────────────────────
# Origines du frontend autorisées en plus de localhost, séparées par des
# virgules. En production : l'URL Vercel, ex. https://untaf.vercel.app
CORS_ORIGINS=

# ── E-mails (Resend, domaine alice-agent.fr) ───────────────
# Tout passe par Resend : candidatures (« Prénom Nom via Alice », réponses au
# candidat), notifications, liens de connexion, alertes. Le domaine doit être
# vérifié dans Resend (SPF/DKIM). Le SMTP ci-dessus ne sert qu'en repli.
RESEND_API_KEY=
MAIL_DOMAIN=alice-agent.fr
# Par défaut : alice@<MAIL_DOMAIN> et candidatures@<MAIL_DOMAIN>.
NOTIFY_FROM_EMAIL=
NOTIFY_FROM_NAME=Alice
APPLICATION_FROM_EMAIL=
# Qui est prévenu quand Alice ne tient pas une promesse (envoi échoué, CV non
# composé, mission vide…). Une alerte par type, par candidat et par jour.
OPS_ALERT_EMAIL=briand@alice-agent.fr
# Racine du frontend, pour les liens des e-mails (connexion, Candidatures).
FRONTEND_URL=https://alice-agent.fr

# ── Suivi des candidatures ─────────────────────────────────
# Jours sans réponse après lesquels Alice propose une relance.
FOLLOWUP_AFTER_DAYS=7

# ── Envoi par Scaleway Transactional Email (prioritaire s'il est rempli) ──
# API HTTPS (Railway bloque le SMTP hors offre Pro). Domaine à vérifier chez Scaleway.
SCALEWAY_TEM_SECRET_KEY=
SCALEWAY_PROJECT_ID=
SCALEWAY_REGION=fr-par

# ── Réponses des recruteurs (réception) ─────────────────
# Recommandé : Cloudflare Email Routing + infra/cloudflare-email-worker
# → POST /api/inbound/email avec l'en-tête X-Inbound-Secret.
INBOUND_SECRET=
# Ne le renseigner qu'une fois la réception testée : les candidatures donnent
# alors l'adresse <prenom.nom.xxxxx>@INBOUND_DOMAIN, Alice lit et transfère.
INBOUND_DOMAIN=
# Alternative : webhook Resend « email.received » → POST /api/inbound/resend
RESEND_WEBHOOK_SECRET=

# ── Candidatures spontanées ─────────────────────────────
# Adresse publique de l'API (lien de désinscription en bas des e-mails).
# Facultatif sur Railway : RAILWAY_PUBLIC_DOMAIN est utilisé à défaut.
PUBLIC_API_URL=
# Expéditeur dédié, idéalement sur un sous-domaine d'envoi séparé.
SPONTANEOUS_FROM_EMAIL=
SPONTANEOUS_DAILY_CAP=5
SPONTANEOUS_WEEKLY_CAP=15
SPONTANEOUS_PER_RUN_MAX=5

# ── Abonnement (Lemon Squeezy) ─────────────────────────
# Vide : facturation éteinte, rien n'est limité (développement).
# Clé : Settings → API. Boutique : Settings → Stores (l'identifiant numérique).
# Variante : produit « Alice — semaine », abonnement hebdomadaire → l'ID de la variante.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
# Settings → Webhooks : URL https://<api>/api/billing/lemonsqueezy, événements
# subscription_* ; le « Signing secret » choisi va ici.
LEMONSQUEEZY_WEBHOOK_SECRET=
BILLING_PRICE_LABEL=4,90 € / semaine
# Limites (fenêtres glissantes de 7 jours, messages : 24 h)
FREE_PACKS_PER_WEEK=3
FREE_MISSIONS_PER_WEEK=1
FREE_SPONTANEOUS_PER_WEEK=0
FREE_MESSAGES_PER_DAY=30
PAID_PACKS_PER_WEEK=40
PAID_MISSIONS_PER_WEEK=14
PAID_MESSAGES_PER_DAY=200
