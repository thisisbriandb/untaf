# ── job-discovery ──────────────────────────────────────────
# Copier vers .env et renseigner les valeurs.
# NE JAMAIS commiter le .env : il contient des secrets réels.

# ── Base de données ────────────────────────────────────────
# En local :
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_discovery
#
# Sur Supabase, prendre la chaîne « Connection pooling » (Settings → Database)
# et remplacer le préfixe par postgresql+asyncpg:// :
#   postgresql+asyncpg://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Le mot de passe de la base est distinct des clés d'API ci-dessous ; aucune
# clé Supabase ne permet de migrer un schéma.
#
# Le schéma est géré par Alembic : `alembic upgrade head`.

# ── Supabase ───────────────────────────────────────────────
SUPABASE_URL=
# Clé « service_role » : réservée au backend. Elle contourne la sécurité au
# niveau des lignes, donc elle ne doit JAMAIS être exposée au navigateur.
# Le frontend utilise la clé « anon », via NEXT_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_KEY=

# ── Redis (courtier Celery) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# true : crée les tables au démarrage et active les logs verbeux.
# À laisser sur false en production, où Alembic prend le relais.
DEBUG=true

# ── Gemini ─────────────────────────────────────────────────
# Requis : conversation, qualification des annonces, rédaction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── France Travail — API « Offres d'emploi v2 » ────────────
# Source principale des offres. Créer une application sur
# https://francetravail.io PUIS l'abonner à « Offres d'emploi v2 » :
# l'abonnement est une étape distincte, et sans lui l'authentification
# renvoie invalid_client.
IDENTIFIER_FRANCE_TRAVAIL=      # client_id, format PAR_<appli>_<hex>
FRANCE_TRAVAIL_API=             # client_secret, 64 caractères hex

# ── Envoi des candidatures (SMTP) ──────────────────────────
# Chaque candidat configure sa propre adresse Gmail depuis Paramètres →
# Envoi d'emails (mot de passe d'application, chiffré en base). Rien à
# renseigner ici : tant qu'un candidat n'a pas configuré la sienne, ses
# candidatures restent SIMULÉES, et l'interface le dit.

# ── Chiffrement des identifiants SMTP ──────────────────────
# Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ne JAMAIS commiter cette clé, ne JAMAIS la perdre — sans elle, tous les
# mots de passe d'application déjà stockés deviennent illisibles.
CREDENTIALS_ENCRYPTION_KEY=

# ── INSEE SIRENE (optionnel) ───────────────────────────────
# Enrichissement des entreprises. https://api.insee.fr/
SIRENE_API_TOKEN=

# ── Scraping ATS ───────────────────────────────────────────
SCRAPE_INTERVAL_HOURS=24
SCRAPE_REQUEST_TIMEOUT=15
SCRAPE_MAX_CONCURRENT=10

# ── Matching ───────────────────────────────────────────────
# Score minimum pour qu'une offre entre dans la liste du candidat.
MATCH_MIN_SCORE=55
# Score à partir duquel elle passe en haut du panier.
MATCH_SHORTLIST_SCORE=78
